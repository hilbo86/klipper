# Arduino Due (SAM3X8E), native USB port, laser CNC shield.
# Copy to .config, run make olddefconfig, then make.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_ATSAM=y
CONFIG_MACH_SAM3X8E=y
CONFIG_ATSAM_USB=y
CONFIG_ATSAM_I2C_RECOVERY=y
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x614e
CONFIG_USB_SERIAL_NUMBER_CHIPID=y
